---
import AgentDemo from '../../components/AgentDemo.astro';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
// Put <!-- agent-demo --> in a project's Markdown to show the agent illustration there.
const DEMO_MARKER = '<!-- agent-demo -->';
const html = project.rendered?.html ?? '';
const [before, after = ''] = html.split(DEMO_MARKER);
const hasDemo = html.includes(DEMO_MARKER);
const { image, imageAlt } = project.data;
---

<Base title={project.data.title} description={project.data.summary} bodyClass="project">
  <div class="progress" aria-hidden="true"></div>
  <article class="prose">
    <Fragment set:html={before} />
    {hasDemo && <AgentDemo />}
    <Fragment set:html={after} />

    {image && (
      <figure class="project-figure">
        <img src={image} alt={imageAlt ?? ''} loading="lazy" />
      </figure>
    )}
  </article>

  <nav class="pager" aria-label="More projects">
    {prev && (
      <a class="prev" href={`/projects/${prev.id}`}>
        <span class="label">← Previous</span>
        <span class="pager-title">{prev.data.title}</span>
      </a>
    )}
    {next && (
      <a class="next" href={`/projects/${next.id}`}>
        <span class="label">Next →</span>
        <span class="pager-title">{next.data.title}</span>
      </a>
    )}
  </nav>
</Base>
