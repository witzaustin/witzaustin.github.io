---
import AgentDemo from '../../components/AgentDemo.astro';
import DashboardDemo from '../../components/DashboardDemo.astro';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
// Put <!-- agent-demo --> or <!-- dashboard-demo --> in a project's Markdown
// to show that animated illustration at that spot.
const demos = { 'agent-demo': AgentDemo, 'dashboard-demo': DashboardDemo };
const html = project.rendered?.html ?? '';
// Splitting with a capture group alternates: html, marker name, html, ...
const parts = html.split(/<!-- (agent-demo|dashboard-demo) -->/);
const { image, imageAlt } = project.data;
---

<Base title={project.data.title} description={project.data.summary} bodyClass="project">
  <div class="progress" aria-hidden="true"></div>
  <article class="prose">
    {parts.map((part, i) => {
      if (i % 2 === 0) return <Fragment set:html={part} />;
      const Demo = demos[part as keyof typeof demos];
      return <Demo />;
    })}

    {image && (
      <figure class="project-figure">
        <img src={image} alt={imageAlt ?? ''} loading="lazy" />
      </figure>
    )}
  </article>

  <nav class="pager" aria-label="More projects">
    {prev && (
      <a class="prev" href={`/projects/${prev.id}`}>
        <span class="label">← Previous</span>
        <span class="pager-title">{prev.data.title}</span>
      </a>
    )}
    {next && (
      <a class="next" href={`/projects/${next.id}`}>
        <span class="label">Next →</span>
        <span class="pager-title">{next.data.title}</span>
      </a>
    )}
  </nav>
</Base>
