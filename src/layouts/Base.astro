---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description, bodyClass } = Astro.props;
const siteName = 'Austin Witz';
const pageTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/ai', label: 'AI' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f4f0ea" />
    <script is:inline>
      // Light by default. Dark only if the visitor picked it with the toggle.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : 'light';
        // Lets CSS hide scroll-triggered content before the first paint.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('motion');
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <div class="wrap">
        <a class="site-name" href="/">Austin Witz</a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href="/Austin_Witz_Resume.pdf">Resume</a>
          <button class="theme-toggle" type="button" aria-label="Switch between light and dark mode">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <a class="footer-mail" href="mailto:witzaustin@gmail.com">witzaustin@gmail.com</a>
        <span>Austin Witz · New York area</span>
        <nav aria-label="Contact">
          <a href="/Austin_Witz_Resume.pdf">Resume</a>
          <a href="https://www.linkedin.com/in/austin-witz">LinkedIn</a>
          <a href="mailto:witzaustin@gmail.com">Email</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('.theme-toggle').addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      // Hairline under the sticky header once the page scrolls.
      (function () {
        var header = document.querySelector('.site-header');
        var onScroll = function () { header.classList.toggle('is-stuck', window.scrollY > 4); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();

      // Scroll effects. Skipped entirely when the visitor prefers reduced motion.
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        // Home intro bullets fade in one by one right after the page loads.
        setTimeout(function () {
          document.documentElement.classList.add('intro-in');
        }, 290);

        // Fade in content blocks as they scroll into view. Anything already on
        // screen at load is left alone so the first view never flickers.
        if ('IntersectionObserver' in window) {
          var targets = document.querySelectorAll('.prose > :not(.cards), .cards > li, .pager');
          var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          }, { rootMargin: '0px 0px -8% 0px' });

          targets.forEach(function (el) {
            if (el.getBoundingClientRect().top < window.innerHeight) return;
            if (el.parentElement.classList.contains('cards')) {
              var index = Array.prototype.indexOf.call(el.parentElement.children, el);
              el.style.transitionDelay = (index % 3) * 70 + 'ms';
            }
            el.classList.add('reveal');
            observer.observe(el);
          });
        }

        // Reading progress bar on project pages.
        var bar = document.querySelector('.progress');
        if (bar) {
          var ticking = false;
          var update = function () {
            var max = document.documentElement.scrollHeight - window.innerHeight;
            bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(window.scrollY / max, 1) : 0) + ')';
            ticking = false;
          };
          window.addEventListener('scroll', function () {
            if (!ticking) { ticking = true; requestAnimationFrame(update); }
          }, { passive: true });
          update();
        }
      })();
    </script>
  </body>
</html>
